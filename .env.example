# --- Stripe ---
# Aus dem Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Price-IDs der 3 Scan-Pakete (Dashboard -> Product Catalog -> Preise anlegen)
STRIPE_PRICE_ID_PACK2=price_...
STRIPE_PRICE_ID_PACK5=price_...
STRIPE_PRICE_ID_PACK10=price_...

# Basis-URL deiner App (für Stripe success/cancel redirects), z.B. https://dein-app.onrender.com
APP_BASE_URL=http://localhost:8000

# Owner-Bypass: geheimer Code, mit dem DU (Bennet) kostenlos scannen kannst,
# ohne über Stripe zu gehen. Frei wählbar, z.B. ein langer Zufallsstring.
OWNER_BYPASS_CODE=change-me-to-a-long-secret

# In-Memory Session Secret (nur zur Signierung interner Tokens, frei wählbar)
APP_SECRET=change-me-too
